{
  "version": 8,
  "name": "X-Brand Basemap",
  "glyphs": "/fonts/{fontstack}/{range}.pbf",
  "sprite": "/sprites/sprite",
  "sources": {
    "iran": {
      "type": "vector",
      "url": "pmtiles://http://localhost:8080/tiles/iran.pmtiles"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#F6F7FB"
      }
    },
    {
      "id": "landcover-urban",
      "type": "fill",
      "source": "iran",
      "source-layer": "landcover",
      "filter": ["==", ["get", "kind"], "urban_area"],
      "paint": {
        "fill-color": "#EDF0F7",
        "fill-opacity": 0.6
      }
    },
    {
      "id": "landcover-green",
      "type": "fill",
      "source": "iran",
      "source-layer": "landcover",
      "filter": ["in", ["get", "kind"], ["literal", ["forest", "grassland"]]],
      "paint": {
        "fill-color": "#E3EAE0",
        "fill-opacity": 0.45
      }
    },
    {
      "id": "landcover-sand",
      "type": "fill",
      "source": "iran",
      "source-layer": "landcover",
      "filter": ["in", ["get", "kind"], ["literal", ["barren", "farmland", "scrub"]]],
      "paint": {
        "fill-color": "#EFEAE0",
        "fill-opacity": 0.4
      }
    },
    {
      "id": "landuse-green",
      "type": "fill",
      "source": "iran",
      "source-layer": "landuse",
      "minzoom": 13,
      "filter": [
        "in",
        ["get", "kind"],
        ["literal", ["park", "garden", "cemetery", "pitch", "recreation_ground"]]
      ],
      "paint": {
        "fill-color": "#EBF0EA",
        "fill-opacity": 0.5
      }
    },
    {
      "id": "water-poly",
      "type": "fill",
      "source": "iran",
      "source-layer": "water",
      "paint": {
        "fill-color": ["case", ["==", ["get", "brunnel"], "tunnel"], "#B6CFE6", "#C9DDF0"]
      }
    },
    {
      "id": "waterway-line",
      "type": "line",
      "source": "iran",
      "source-layer": "water",
      "minzoom": 8,
      "filter": ["!=", ["get", "brunnel"], "tunnel"],
      "paint": {
        "line-color": "#C9DDF0",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.6, 12, 1.4, 16, 3.2]
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "iran",
      "source-layer": "buildings",
      "minzoom": 14,
      "filter": ["!=", ["get", "kind"], "address"],
      "paint": {
        "fill-color": "#E6E9F0",
        "fill-opacity": 0.9
      }
    },
    {
      "id": "highway-casing",
      "type": "line",
      "source": "iran",
      "source-layer": "roads",
      "minzoom": 5,
      "filter": ["==", ["get", "kind"], "highway"],
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 1.6, 9, 3.5, 14, 9, 18, 22]
      }
    },
    {
      "id": "highway",
      "type": "line",
      "source": "iran",
      "source-layer": "roads",
      "minzoom": 5,
      "filter": ["==", ["get", "kind"], "highway"],
      "paint": {
        "line-color": "#F6DFA6",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 1, 9, 2.2, 14, 7, 18, 18]
      }
    },
    {
      "id": "major-casing",
      "type": "line",
      "source": "iran",
      "source-layer": "roads",
      "minzoom": 9,
      "filter": ["==", ["get", "kind"], "major_road"],
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": ["interpolate", ["linear"], ["zoom"], 9, 1.2, 14, 5, 18, 13]
      }
    },
    {
      "id": "major",
      "type": "line",
      "source": "iran",
      "source-layer": "roads",
      "minzoom": 9,
      "filter": ["==", ["get", "kind"], "major_road"],
      "paint": {
        "line-color": "#F3EFE6",
        "line-width": ["interpolate", ["linear"], ["zoom"], 9, 0.8, 14, 3.5, 18, 10]
      }
    },
    {
      "id": "minor-casing",
      "type": "line",
      "source": "iran",
      "source-layer": "roads",
      "minzoom": 12.5,
      "filter": ["==", ["get", "kind"], "minor_road"],
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12.5, 0.8, 16, 3.5, 18, 7]
      }
    },
    {
      "id": "minor",
      "type": "line",
      "source": "iran",
      "source-layer": "roads",
      "minzoom": 12.5,
      "filter": ["==", ["get", "kind"], "minor_road"],
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12.5, 0.5, 16, 2.5, 18, 5.5]
      }
    },
    {
      "id": "path",
      "type": "line",
      "source": "iran",
      "source-layer": "roads",
      "minzoom": 15,
      "filter": ["==", ["get", "kind"], "path"],
      "paint": {
        "line-color": "#E7E9EE",
        "line-width": ["interpolate", ["linear"], ["zoom"], 15, 0.5, 18, 2]
      },
      "layout": {
        "line-cap": "round"
      }
    },
    {
      "id": "rail",
      "type": "line",
      "source": "iran",
      "source-layer": "roads",
      "minzoom": 10,
      "filter": ["==", ["get", "kind"], "rail"],
      "paint": {
        "line-color": "#C3C9D6",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.4, 16, 1.6]
      }
    },
    {
      "id": "boundary-country",
      "type": "line",
      "source": "iran",
      "source-layer": "boundaries",
      "minzoom": 3,
      "filter": ["==", ["get", "kind"], "country"],
      "paint": {
        "line-color": "#C6CCDA",
        "line-width": ["interpolate", ["linear"], ["zoom"], 3, 0.6, 8, 1.6]
      }
    },
    {
      "id": "road-labels",
      "type": "symbol",
      "source": "iran",
      "source-layer": "roads",
      "minzoom": 14,
      "filter": ["has", ["get", "name"]],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:fa"], ["get", "name"]],
        "text-font": ["Vazirmatn Regular"],
        "text-size": 11
      },
      "paint": {
        "text-color": "#475569",
        "text-halo-color": "#F6F7FB",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "place-country",
      "type": "symbol",
      "source": "iran",
      "source-layer": "places",
      "minzoom": 2.5,
      "filter": ["==", ["get", "kind"], "country"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:fa"], ["get", "name"]],
        "text-font": ["Vazirmatn Bold"],
        "text-size": 13,
        "text-transform": "uppercase",
        "text-letter-spacing": 0.08
      },
      "paint": {
        "text-color": "#0F172A",
        "text-halo-color": "#F6F7FB",
        "text-halo-width": 1.6
      }
    },
    {
      "id": "place-city",
      "type": "symbol",
      "source": "iran",
      "source-layer": "places",
      "minzoom": 4,
      "filter": ["all", ["==", ["get", "kind"], "locality"], ["<=", ["get", "min_zoom"], 8]],
      "layout": {
        "text-field": ["coalesce", ["get", "name:fa"], ["get", "name"]],
        "text-font": ["Vazirmatn Bold"],
        "text-size": 12
      },
      "paint": {
        "text-color": "#0F172A",
        "text-halo-color": "#F6F7FB",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "place-town",
      "type": "symbol",
      "source": "iran",
      "source-layer": "places",
      "minzoom": 8,
      "filter": [
        "all",
        ["==", ["get", "kind"], "locality"],
        [">", ["get", "min_zoom"], 8],
        ["<=", ["get", "min_zoom"], 10.5]
      ],
      "layout": {
        "text-field": ["coalesce", ["get", "name:fa"], ["get", "name"]],
        "text-font": ["Vazirmatn Medium"],
        "text-size": 11
      },
      "paint": {
        "text-color": "#475569",
        "text-halo-color": "#F6F7FB",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "place-village",
      "type": "symbol",
      "source": "iran",
      "source-layer": "places",
      "minzoom": 11,
      "filter": ["all", ["==", ["get", "kind"], "locality"], [">", ["get", "min_zoom"], 10.5]],
      "layout": {
        "text-field": ["coalesce", ["get", "name:fa"], ["get", "name"]],
        "text-font": ["Vazirmatn Regular"],
        "text-size": 10
      },
      "paint": {
        "text-color": "#475569",
        "text-halo-color": "#F6F7FB",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "place-neighbourhood",
      "type": "symbol",
      "source": "iran",
      "source-layer": "places",
      "minzoom": 12,
      "filter": ["in", ["get", "kind"], ["literal", ["neighbourhood", "macrohood"]]],
      "layout": {
        "text-field": ["coalesce", ["get", "name:fa"], ["get", "name"]],
        "text-font": ["Vazirmatn Regular"],
        "text-size": 10,
        "text-letter-spacing": 0.05
      },
      "paint": {
        "text-color": "#475569",
        "text-halo-color": "#F6F7FB",
        "text-halo-width": 1.2
      }
    }
  ]
}
