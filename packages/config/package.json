{
  "name": "@app/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./eslint": {
      "import": "./src/eslint.mjs"
    },
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./tsconfig.node.json": "./tsconfig.node.json",
    "./tsconfig.next.json": "./tsconfig.next.json"
  },
  "files": [
    "dist",
    "src/eslint.mjs",
    "tsconfig.base.json",
    "tsconfig.node.json",
    "tsconfig.next.json"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "echo no tests yet"
  },
  "dependencies": {},
  "devDependencies": {
    "tsup": "8.3.5",
    "typescript": "5.6.3",
    "eslint": "9.16.0",
    "typescript-eslint": "8.18.0",
    "@types/node": "22.10.2"
  }
}
