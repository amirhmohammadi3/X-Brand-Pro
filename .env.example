# .env.example — copy to .env and fill in real values. Never commit .env.
# `pnpm env:init` (scripts/gen-secrets.mjs, added by prompt I1.1) fills the
# secret keys with random values if they are still empty.

# --- runtime ---
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
PUBLIC_WEB_URL=http://localhost:3000
API_INTERNAL_URL=http://localhost:4000

# --- web client (build-time, public; consumed via next.config) ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# --- database (matches infra/docker-compose.dev.yml) ---
DATABASE_URL=postgres://app:app_dev_password@localhost:5432/app
TEST_DATABASE_URL=postgres://app:app_dev_password@localhost:5432/app_test

# --- redis (db 0 for app, db 15 for tests) ---
REDIS_URL=redis://localhost:6379/0
TEST_REDIS_URL=redis://localhost:6379/15

# --- mailpit (dev SMTP) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM="no-reply@localhost"

# --- secrets (filled by `pnpm env:init`; never commit real values) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# HMAC key for one-time codes (min 32 chars). The plain code is NEVER stored;
# only HMAC-SHA256("<otpId>:<code>") lands in the database.
OTP_HMAC_SECRET=
SETTINGS_ENCRYPTION_KEY=

# --- auth cookies & token lifetimes (B1.3) ---
ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=30
# Leave empty to scope cookies to the current host; set a domain like
# `.example.com` to share cookies across subdomains.
COOKIE_DOMAIN=
# Leave empty to default to `true` when NODE_ENV=production, `false` otherwise.
COOKIE_SECURE=

# --- storage ---
STORAGE_ROOT=./data/storage
MEDIA_PUBLIC_BASE=/media

# --- dev tools ---
DEV_TOOLS=true

# --- seed superadmin (dev only; change before any real deploy) ---
SEED_SUPERADMIN_USERNAME=admin
# The seeder refuses this exact example value in production.
SEED_SUPERADMIN_PASSWORD=ChangeMe_SuperAdmin1
SEED_SUPERADMIN_EMAIL=admin@example.com
